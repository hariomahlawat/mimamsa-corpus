{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.mimamsa.invalid/c16/BUILD_SPEC_SCHEMA.json",
  "title": "MKR-1 central build spec (B02; contract 2.1 interface)",
  "description": "The one input of `python -m mimamsa_kbuild build --spec <file>`: everything a deterministic central build depends on, pinned. Stages S0-S9 run in order; only S1 (fetch) may use the network; every output is a function of this spec (no wall clock: pinned_build_time). The resource budget bounds concurrency because the build host is shared (Codex runs OCR on the same machine). See docs/architecture/c16/interfaces/B02_CENTRAL_BUILD_SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "record_kind", "build_id", "pinned_build_time", "release", "inputs", "stages", "resources", "output_dir"],
  "properties": {
    "contract": {"const": "mimamsa-corpus-contract/2.1"},
    "record_kind": {"const": "mkr_build_spec"},
    "build_id": {"type": "string", "pattern": "^B-[0-9]{8}-[a-z0-9-]{1,40}$"},
    "pinned_build_time": {"$ref": "C16_SHARED_DEFINITIONS_SCHEMA.json#/$defs/datetime"},
    "release": {
      "type": "object", "additionalProperties": false, "required": ["release_id", "release_sequence", "base_mode", "base_release_id", "signing_mode"],
      "properties": {
        "release_id": {"type": "string", "pattern": "^R[0-9]{2,3}-[a-z0-9-]{1,40}-[0-9]{8}-[0-9a-f]{8}$"},
        "release_sequence": {"type": "integer", "minimum": 1},
        "base_mode": {"enum": ["FULL", "DELTA"]},
        "base_release_id": {"type": ["string", "null"]},
        "signing_mode": {"description": "DEVELOPMENT in Tranche B; PRODUCTION means S8 only prepares SHA256SUMS for the owner's offline signature.", "enum": ["DEVELOPMENT", "PRODUCTION"]}
      }
    },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["producer_generations", "hf", "git", "restricted_register_sha256", "contracts", "models", "tools"],
      "properties": {
        "producer_generations": {"description": "Strict C16 exchanges, pinned by the sha256 of their GENERATION.json and where they are preserved.", "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["corpus_generation_id", "generation_manifest_sha256", "hf_repo", "hf_revision", "path"],
          "properties": {"corpus_generation_id": {"$ref": "C16_SHARED_DEFINITIONS_SCHEMA.json#/$defs/corpus_generation_id"}, "generation_manifest_sha256": {"$ref": "C16_SHARED_DEFINITIONS_SCHEMA.json#/$defs/sha256"}, "hf_repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "hf_revision": {"$ref": "../v1/common.schema.json#/$defs/hf_revision"}, "path": {"$ref": "C16_SHARED_DEFINITIONS_SCHEMA.json#/$defs/relative_path"}}}},
        "hf": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["repo", "revision", "purpose"], "properties": {"repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "revision": {"$ref": "../v1/common.schema.json#/$defs/hf_revision"}, "purpose": {"type": "string", "minLength": 3, "maxLength": 200}}}},
        "git": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["commit", "purpose"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "purpose": {"type": "string", "minLength": 3, "maxLength": 200}}}},
        "restricted_register_sha256": {"$ref": "C16_SHARED_DEFINITIONS_SCHEMA.json#/$defs/sha256"},
        "contracts": {"type": "object", "additionalProperties": false, "required": ["v1", "corpus"], "properties": {"v1": {"$ref": "../v1/common.schema.json#/$defs/semver"}, "corpus": {"$ref": "C16_SHARED_DEFINITIONS_SCHEMA.json#/$defs/contract"}}},
        "models": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["role", "model_id", "sha256"], "properties": {"role": {"enum": ["EMBEDDER", "RERANKER", "OCR", "TOKENIZER"]}, "model_id": {"type": "string", "maxLength": 200}, "sha256": {"$ref": "C16_SHARED_DEFINITIONS_SCHEMA.json#/$defs/sha256"}}}},
        "tools": {"type": "array", "minItems": 1, "items": {"$ref": "C16_SHARED_DEFINITIONS_SCHEMA.json#/$defs/tool"}}
      }
    },
    "stages": {
      "description": "Exactly S0..S9 in order. network may be true only for S1.",
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {"type": "object", "additionalProperties": false, "required": ["stage_id", "name", "network", "max_workers"],
        "properties": {"stage_id": {"enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9"]}, "name": {"enum": ["spec", "fetch", "validate", "text", "bundle", "ref-import", "accelerate", "assemble", "sign", "verify"]}, "network": {"type": "boolean"}, "max_workers": {"type": "integer", "minimum": 1}}}
    },
    "resources": {
      "description": "Shared-host budget. Host figures are MEASURED on the build host (not assumed). When shared_host is true, workers are bounded to half the measured logical CPUs (at least 1), priorities are below normal, and memory and disk limits are hard stops for the build (it pauses or fails, never starves the co-tenant).",
      "type": "object", "additionalProperties": false,
      "required": ["shared_host", "measured_logical_cpus", "measured_memory_bytes", "max_workers", "max_memory_bytes", "max_disk_bytes", "cpu_priority", "io_priority"],
      "properties": {
        "shared_host": {"type": "boolean"},
        "measured_logical_cpus": {"type": "integer", "minimum": 1},
        "measured_memory_bytes": {"type": "integer", "minimum": 1},
        "max_workers": {"type": "integer", "minimum": 1},
        "max_memory_bytes": {"type": "integer", "minimum": 1},
        "max_disk_bytes": {"type": "integer", "minimum": 1},
        "cpu_priority": {"enum": ["IDLE", "BELOW_NORMAL", "NORMAL"]},
        "io_priority": {"enum": ["VERY_LOW", "LOW", "NORMAL"]}
      }
    },
    "output_dir": {"$ref": "C16_SHARED_DEFINITIONS_SCHEMA.json#/$defs/relative_path"}
  }
}
