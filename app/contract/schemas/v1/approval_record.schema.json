{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.mimamsa.invalid/v1/approval_record.schema.json",
  "title": "Legal approval record (data layer 6: legally authenticated records)",
  "description": "An attributable legal approval at a stated tier and scope, pinned to an exact revision, under a recorded appointment, with the approval artefact preserved by hash. Admin capacity never confers approval. While AUTH-LEDGER is at version 0 no approval record may appear in a release bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "record_kind", "approval_record_id", "appointment_id", "approver", "capacity", "tier", "scope", "subject", "pinned_revision", "artefact_sha256", "decided_at", "status"],
  "properties": {
    "contract_version": {"$ref": "common.schema.json#/$defs/contract_version"},
    "record_kind": {"const": "approval_record"},
    "approval_record_id": {"type": "string", "pattern": "^AP-[A-Za-z0-9._-]{3,80}$"},
    "appointment_id": {"type": "string", "pattern": "^APPT-[A-Za-z0-9._-]{3,80}$"},
    "approver": {"type": "string", "minLength": 2, "maxLength": 300},
    "capacity": {"enum": ["DESIGNATED_LEGAL_ADVISER", "FORMAL_JAG_APPROVER"]},
    "tier": {"enum": ["APPROVAL_RECORDED_UNCONFIRMED", "T1_LEGAL_ADVISER_REVIEWED", "T2_FORMAL_JAG_VALIDATED"]},
    "scope": {"type": "string", "minLength": 3, "maxLength": 2000},
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "properties": {"kind": {"enum": ["document", "candidate", "provision_version", "template_version"]}, "id": {"type": "string", "maxLength": 200}}
    },
    "pinned_revision": {"type": "string", "minLength": 7, "maxLength": 80},
    "artefact_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "decided_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ACTIVE", "REVOKED", "SUPERSEDED"]}
  }
}
