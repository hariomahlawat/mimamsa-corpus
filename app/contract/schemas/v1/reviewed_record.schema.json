{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.mimamsa.invalid/v1/reviewed_record.schema.json",
  "title": "Independently reviewed record (data layer 5)",
  "description": "A documentary or technical review of one axis value of one existing subject in the same bundle. Independence is checked structurally (reviewer_id differs from the reviewed artefact's author_id; the subject exists; reviewed_commit matches the commit that produced the subject), not by self-declaration. Technical reviews (human or AI) can never set legal_applicability or legal_approval, and an AI review can never confirm source identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "record_kind",
    "review_record_id",
    "subject",
    "axis",
    "from_value",
    "to_value",
    "reviewer",
    "method",
    "decided_at",
    "record_location",
    "reviewed_artefact"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/contract_version"
    },
    "record_kind": {
      "const": "reviewed_record"
    },
    "review_record_id": {
      "type": "string",
      "pattern": "^RV-[A-Za-z0-9._-]{3,80}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "document",
            "derived_text",
            "candidate",
            "source_copy"
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "axis": {
      "enum": [
        "source_integrity",
        "source_authenticity",
        "evidence_fidelity",
        "dependency_freshness"
      ]
    },
    "from_value": {
      "type": "string",
      "maxLength": 64
    },
    "to_value": {
      "type": "string",
      "maxLength": 64
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "name_or_role",
        "kind"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "name_or_role": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "HUMAN",
            "AI_AGENT"
          ]
        }
      }
    },
    "method": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/page_anchor"
      }
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_location": {
      "description": "Where the full review is kept (repository path at a commit).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "commit"
      ],
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/relative_path"
        },
        "commit": {
          "$ref": "common.schema.json#/$defs/git_commit"
        }
      }
    },
    "reviewed_artefact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_id",
        "reviewed_commit"
      ],
      "properties": {
        "author_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "reviewed_commit": {
          "$ref": "common.schema.json#/$defs/git_commit"
        }
      }
    }
  }
}
