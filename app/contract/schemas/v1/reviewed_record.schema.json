{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.mimamsa.invalid/v1/reviewed_record.schema.json",
  "title": "Independently reviewed record (data layer 5)",
  "description": "A documentary or technical review that raised (or lowered) one axis value of one subject. It is evidence for evidence_fidelity, source_authenticity, legal_applicability or dependency_freshness changes. It is never a legal approval (that is approval_record). The reviewer must be independent of the author of the reviewed artefact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "record_kind", "review_record_id", "subject", "axis", "from_value", "to_value", "reviewer", "independent_of_author", "method", "decided_at", "record_location"],
  "properties": {
    "contract_version": {"$ref": "common.schema.json#/$defs/contract_version"},
    "record_kind": {"const": "reviewed_record"},
    "review_record_id": {"type": "string", "pattern": "^RV-[A-Za-z0-9._-]{3,80}$"},
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["document", "derived_text", "candidate", "source_copy"]},
        "id": {"type": "string", "maxLength": 200}
      }
    },
    "axis": {"enum": ["source_integrity", "source_authenticity", "evidence_fidelity", "legal_applicability", "dependency_freshness"]},
    "from_value": {"type": "string", "maxLength": 64},
    "to_value": {"type": "string", "maxLength": 64},
    "reviewer": {
      "type": "object", "additionalProperties": false, "required": ["name_or_role", "kind"],
      "properties": {
        "name_or_role": {"type": "string", "minLength": 2, "maxLength": 200},
        "kind": {"enum": ["HUMAN", "AI_AGENT_INDEPENDENT"]}
      }
    },
    "independent_of_author": {"const": true},
    "method": {"type": "string", "minLength": 10, "maxLength": 2000},
    "anchors": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/page_anchor"}},
    "decided_at": {"type": "string", "format": "date-time"},
    "record_location": {
      "description": "Where the full review is kept (repository path at a commit).",
      "type": "object", "additionalProperties": false, "required": ["path", "commit"],
      "properties": {"path": {"$ref": "common.schema.json#/$defs/relative_path"}, "commit": {"$ref": "common.schema.json#/$defs/git_commit"}}
    }
  }
}
