<Project Sdk="Microsoft.NET.Sdk">
  <!-- C14 S4 benchmark/calibration tool (not part of the service or the solution). Links the Hybrid sources and uses the
       DirectML build of ONNX Runtime so the same code can be timed on CPU and on the GTX 1650 Ti without a CUDA toolkit. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Mimamsa.Hybrid\E5Embedder.cs" Link="E5Embedder.cs" />
    <Compile Include="..\..\src\Mimamsa.Hybrid\DenseIndex.cs" Link="DenseIndex.cs" />
    <Compile Include="..\..\src\Mimamsa.Hybrid\VectorStore.cs" Link="VectorStore.cs" />
    <ProjectReference Include="..\..\src\Mimamsa.Core\Mimamsa.Core.csproj" />
  </ItemGroup>
</Project>
