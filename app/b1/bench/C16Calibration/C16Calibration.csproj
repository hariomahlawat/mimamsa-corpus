<Project Sdk="Microsoft.NET.Sdk">
  <!-- C16 Stage 3 S3-B calibration study (not part of the service or the solution): measures false-accept and
       false-reject behaviour of the B04 sampled checks (SAMPLED_REBUILD_PARITY, SAMPLED_POSTINGS_REDERIVE,
       SAMPLED_QUERY_PARITY, VECTOR_SPOT_REEMBED) under injected corruption on a real sample and at synthetic scale, and
       their cost per sample size. It PROPOSES values for owner decision; it never writes a contract. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Mimamsa.Core\Mimamsa.Core.csproj" />
    <ProjectReference Include="..\..\src\Mimamsa.Hybrid\Mimamsa.Hybrid.csproj" />
  </ItemGroup>
</Project>
