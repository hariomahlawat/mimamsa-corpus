# IndexBench Program.cs, --phase-profile block (inserted before the --parity branch):
if (args.Contains("--phase-profile"))
{
    var ps = new SearchService(ix, _ => false);
    foreach (var q in Q) { var r0 = ps.Search(q, new SearchFilters()); ps.Page(r0, 1, 25, null); }
    string[] names = { "identifier_tiers", "case_name_title_speller", "scores_eval", "order_hits", "hidden_filter", "facets", "filter_distinct", "page", "clause_eval", "postings_fetch", "tf_accumulate", "score_note" };
    var rows = new List<object>();
    foreach (var q in Q)
    {
        var ticks = new long[16];
        long alloc0 = GC.GetAllocatedBytesForCurrentThread(); var sw0 = Stopwatch.StartNew();
        for (int i = 0; i < 5; i++)
        {
            Prof.T = new long[16];
            var r0 = ps.Search(q, new SearchFilters()); var pg0 = ps.Page(r0, 1, 25, null); foreach (var h in pg0.Hits) _ = h.Reasons.Count;
            for (int k = 0; k < 16; k++) ticks[k] += Prof.T[k];
        }
        double tot = sw0.Elapsed.TotalMilliseconds / 5; long alloc = (GC.GetAllocatedBytesForCurrentThread() - alloc0) / 5;
        var hitsN = ps.Search(q, new SearchFilters()).TotalPassages;
        rows.Add(new { q, hits = hitsN, total_ms = Math.Round(tot, 1), alloc_mb = Math.Round(alloc / 1048576.0, 1),
            phases_ms = names.Select((n, k) => (n, v: Math.Round(ticks[k] * 1000.0 / Stopwatch.Frequency / 5, 1))).Where(x => x.v > 0).ToDictionary(x => x.n, x => x.v) });
    }
    var pj = JsonSerializer.Serialize(rows, new JsonSerializerOptions { WriteIndented = true });
    Console.WriteLine(pj); if (Arg("--out") is { } po) File.WriteAllText(po, pj);
    return;
}
