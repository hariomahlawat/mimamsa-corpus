    <ProjectReference Include="..\Mimamsa.Activation.TestHost\Mimamsa.Activation.TestHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="hybrid_tokenizer_vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="reranker_tokenizer_vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures\c16_b01\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
