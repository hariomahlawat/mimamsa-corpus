<Project Sdk="Microsoft.NET.Sdk">
  <!-- C16 B06: the activation tool (single journal writer). Production entry point: no crash or pause hooks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Mimamsa.Activation</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mimamsa.Core\Mimamsa.Core.csproj" />
  </ItemGroup>
</Project>
