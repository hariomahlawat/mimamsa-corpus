<Project Sdk="Microsoft.NET.Sdk">
  <!-- C16 B06: the activation tool (single journal writer). Production entry point: no crash or pause hooks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Mimamsa.Activation</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mimamsa.Core\Mimamsa.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- C16 S3-C (B07): `service-job` runs as a Windows service under its virtual account (installer acceptance tests). -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
  </ItemGroup>
</Project>
