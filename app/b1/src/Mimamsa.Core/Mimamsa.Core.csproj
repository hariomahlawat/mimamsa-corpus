<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral application core (ADR-0005 §4a). No ASP.NET Core or OS-specific dependency. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="10.0.4" />
    <!-- C15 WP1 persistent search index (ADR-0008). MIT; bundles SQLitePCLRaw e_sqlite3 natives (Apache-2.0 / SQLite public domain). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mimamsa.Tests" />
  </ItemGroup>
</Project>
