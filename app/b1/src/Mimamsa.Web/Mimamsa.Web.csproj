<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Host adapter: ASP.NET Core on Kestrel, Windows Service lifetime (AD-1), Kestrel protected-delivery transport (AD-6). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Mimamsa.Web</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mimamsa.Core\Mimamsa.Core.csproj" />
    <ProjectReference Include="..\Mimamsa.Hybrid\Mimamsa.Hybrid.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mimamsa.Tests" />
  </ItemGroup>
</Project>
