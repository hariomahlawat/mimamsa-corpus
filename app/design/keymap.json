{
  "$description": "Mimamsa keymap v0.2 (conflict-free with browser_reserved_keys.json; tested by tests/test_keymap.py). scope 'global' = active when focus is not in an editable field; single-key shortcuts can be switched off in user settings (WCAG 2.1.4). Sequences are written 'G then R'. Browser-native keys (F3 find, F6 address bar, Ctrl+F) are left to the browser.",
  "bindings": [
    {"keys": "/", "action": "Focus search", "scope": "global", "single_key": true},
    {"keys": "Escape", "action": "Leave field / close popover", "scope": "any", "single_key": true},
    {"keys": "?", "action": "Shortcut help", "scope": "global", "single_key": true},
    {"keys": "Shift+Semicolon", "action": "Command palette (':')", "scope": "global", "single_key": true},
    {"keys": "G then R", "action": "Research workspace", "scope": "global", "single_key": true},
    {"keys": "G then S", "action": "Statutes workspace", "scope": "global", "single_key": true},
    {"keys": "G then G", "action": "Graph workspace", "scope": "global", "single_key": true},
    {"keys": "G then D", "action": "Document Studio", "scope": "global", "single_key": true},
    {"keys": "G then A", "action": "Administration (Admin only)", "scope": "global", "single_key": true},
    {"keys": "Period", "action": "Next pane", "scope": "global", "single_key": true},
    {"keys": "Comma", "action": "Previous pane", "scope": "global", "single_key": true},
    {"keys": "B", "action": "Toggle left rail", "scope": "global", "single_key": true},
    {"keys": "Shift+B", "action": "Toggle context pane", "scope": "global", "single_key": true},
    {"keys": "J", "action": "Next result", "scope": "results", "single_key": true},
    {"keys": "K", "action": "Previous result", "scope": "results", "single_key": true},
    {"keys": "ArrowDown", "action": "Next result", "scope": "results", "single_key": true},
    {"keys": "ArrowUp", "action": "Previous result", "scope": "results", "single_key": true},
    {"keys": "Enter", "action": "Open result in current tab", "scope": "results", "single_key": true},
    {"keys": "O", "action": "Open result in new app tab", "scope": "results", "single_key": true},
    {"keys": "Space", "action": "Preview result", "scope": "results", "single_key": true},
    {"keys": "N", "action": "Next hit in document", "scope": "document", "single_key": true},
    {"keys": "Shift+N", "action": "Previous hit in document", "scope": "document", "single_key": true},
    {"keys": "P", "action": "Go to page", "scope": "document", "single_key": true},
    {"keys": "C", "action": "Copy legal citation", "scope": "document", "single_key": true},
    {"keys": "Shift+C", "action": "Copy internal reference and permalink", "scope": "document", "single_key": true},
    {"keys": "T", "action": "Toggle Original / Text", "scope": "document", "single_key": true},
    {"keys": "M", "action": "New note pinned to current passage", "scope": "document", "single_key": true},
    {"keys": "E", "action": "Open Evidence panel", "scope": "document", "single_key": true},
    {"keys": "X", "action": "Close app tab", "scope": "document", "single_key": true},
    {"keys": "BracketRight", "action": "Next app tab", "scope": "global", "single_key": true},
    {"keys": "BracketLeft", "action": "Previous app tab", "scope": "global", "single_key": true},
    {"keys": "Alt+ArrowDown", "action": "Open search suggestions", "scope": "search_field", "single_key": false},
    {"keys": "Ctrl+Enter", "action": "Run search in a new app tab", "scope": "search_field", "single_key": false},
    {"keys": "ArrowLeft", "action": "Resize focused divider 16 px", "scope": "divider", "single_key": true},
    {"keys": "ArrowRight", "action": "Resize focused divider 16 px", "scope": "divider", "single_key": true},
    {"keys": "Shift+ArrowLeft", "action": "Resize focused divider 64 px", "scope": "divider", "single_key": false},
    {"keys": "Shift+ArrowRight", "action": "Resize focused divider 64 px", "scope": "divider", "single_key": false},
    {"keys": "Home", "action": "Collapse pane (divider)", "scope": "divider", "single_key": true},
    {"keys": "End", "action": "Expand pane (divider)", "scope": "divider", "single_key": true}
  ]
}
