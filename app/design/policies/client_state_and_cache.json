{
  "$description": "Client-side state and HTTP caching policy for shared office desktops (finding F07). Normative for B1. Tested by tests/test_client_policy.py; the B1 implementation must add an HTTP-level test that asserts these headers on every route class.",
  "version": "0.1.0",
  "response_classes": {
    "original_pdf":          {"cache_control": "no-store", "pragma": "no-cache", "content_disposition": "inline", "notes": "originals stream after hash check; never cached by the browser"},
    "working_document":      {"cache_control": "no-store", "pragma": "no-cache", "content_disposition": "inline", "notes": "Document Studio files, page images and OCR output; owner-checked; never cached"},
    "search_results":        {"cache_control": "no-store", "pragma": "no-cache"},
    "snippets_and_text":     {"cache_control": "no-store", "pragma": "no-cache"},
    "document_metadata":     {"cache_control": "no-store", "pragma": "no-cache"},
    "notes_and_workspace":   {"cache_control": "no-store", "pragma": "no-cache"},
    "admin":                 {"cache_control": "no-store", "pragma": "no-cache"},
    "static_assets_hashed":  {"cache_control": "public, max-age=31536000, immutable", "notes": "content-hashed JS/CSS/fonts/icons only; contain no corpus or user data"}
  },
  "logout": {"clear_site_data": "\"cache\", \"storage\"", "server_session_invalidated": true, "client_memory_cleared": true},
  "idle_timeout_minutes": 30,
  "client_storage": {
    "localStorage": "forbidden",
    "indexedDB": "forbidden",
    "service_worker": "forbidden",
    "cache_storage_api": "forbidden",
    "sessionStorage": "allowed_for_ui_layout_only",
    "sessionStorage_allowed_keys": ["pane_widths", "rail_collapsed", "view_mode", "theme"],
    "never_on_client": ["search_query_text", "search_history", "document_text", "snippets", "notes", "working_document_content", "tabs_with_document_ids"]
  },
  "server_side_per_user_state": ["recent_queries", "search_history", "open_tabs", "pane_layout", "saved_searches", "research_sets", "notes", "pins"],
  "offline_behaviour": "When the server is unreachable the client shows a reconnecting notice and no cached content; there is no offline cached view.",
  "pdfjs": {"disable_range_cache_persistence": true, "disableAutoFetch": false, "isEvalSupported": false, "enableScripting": false}
}
