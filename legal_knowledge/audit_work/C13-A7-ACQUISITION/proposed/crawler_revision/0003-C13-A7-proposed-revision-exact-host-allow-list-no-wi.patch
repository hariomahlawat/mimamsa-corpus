@@ -100,6 +103,35 @@ def replay_transport(directory: Path | str) -> httpx.MockTransport:
     return httpx.MockTransport(handler)
 
 
+CA_BUNDLE_ENV = ("SSL_CERT_FILE", "REQUESTS_CA_BUNDLE")
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+
+def load_pinned_pem(src: dict) -> Path:
+    """Validate a source's `ca_extra_pem` (extra intermediate certificates the server omits) against
+    `ca_extra_sha256` (SHA-256 of each certificate's DER form). Returns the PEM path. Raises on any mismatch."""
+    p = REPO_ROOT / src["ca_extra_pem"]
+    pins = {str(x).lower() for x in src.get("ca_extra_sha256") or []}
+    blocks = re.findall(r"-----BEGIN CERTIFICATE-----(.+?)-----END CERTIFICATE-----", p.read_text(), re.S)
+    found = {hashlib.sha256(base64.b64decode("".join(b.split()))).hexdigest() for b in blocks}
+    if not pins or found != pins:
+        raise ValueError(f"{p.name}: certificates {sorted(found)} do not equal ca_extra_sha256 {sorted(pins)}")
+    return p
+
+
+def tls_verify_for(src: dict):
+    """httpx `verify` value for a source. Verification is never disabled. With `ca_extra_pem`, the pinned
+    intermediates are added for chain building and VERIFY_X509_PARTIAL_CHAIN is cleared, so the chain must still
+    end at a self-signed root in the normal trust store."""
+    if not src.get("ca_extra_pem"):
+        return True
+    bundle = next((os.environ[e] for e in CA_BUNDLE_ENV if os.environ.get(e)), None)
+    ctx = ssl.create_default_context(cafile=bundle) if bundle else ssl.create_default_context()
+    ctx.load_verify_locations(str(load_pinned_pem(src)))
+    ctx.verify_flags &= ~ssl.VERIFY_X509_PARTIAL_CHAIN
+    return ctx
+
+
 def is_pdf_url(url: str) -> bool:
     """True if the path, or any query value (…?file=x.pdf), names a PDF."""
     parts = urlsplit(url)
