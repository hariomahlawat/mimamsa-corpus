diff --git a/tests/test_crawler_c13_hardening.py b/tests/test_crawler_c13_hardening.py
new file mode 100644
index 00000000..3ea8e84d
--- /dev/null
+++ b/tests/test_crawler_c13_hardening.py
@@ -0,0 +1,75 @@
+"""C13 A7 revision guards (offline): no wildcard trust, item-scoped redirects, pinned extra CA, From header opt-in."""
+import copy
+import ssl
+
+import pytest
+
+from crawler.config import Config, check_config, load_config
+from crawler import http as chttp
+
+EGZ_PINS = ["13949634d99cd6fd6aa80bc034fefacceb1969feef986586713ecdbb05758d3f",
+            "072639d0b140d5bffae16ad9c3f6cc6086040621f51ee61a6d46a8915c07cf76"]
+
+
+def _cfg(mutate):
+    raw = copy.deepcopy(load_config().raw)
+    mutate(raw)
+    base = load_config()
+    return Config(raw, base.path)
+
+
+def test_wildcard_host_is_not_honoured_and_is_a_config_error():
+    def m(raw):
+        raw["sources"]["archive"]["allowed_hosts"] = ["archive.org", "*.archive.org"]
+    cfg = _cfg(m)
+    assert not cfg.is_url_allowed("archive", "https://ia800408.us.archive.org/9/items/x/x.pdf")[0]
+    assert any("wildcard host" in e for e in check_config(cfg).errors)
+
+
+def test_redirect_scope_allows_only_the_item_directory_on_that_node():
+    def m(raw):
+        raw["sources"]["archive"]["redirect_scopes"] = [
+            {"host": "ia800408.us.archive.org", "path_prefix": "/9/items/in.gazette.central.w.1960-10-08.88375/"}]
+    cfg = _cfg(m)
+    ok = "https://ia800408.us.archive.org/9/items/in.gazette.central.w.1960-10-08.88375/88375.pdf"
+    assert cfg.is_url_allowed("archive", ok)[0]
+    assert not cfg.is_url_allowed("archive", ok.replace("https://", "http://"))[0]
+    assert not cfg.is_url_allowed("archive", "https://ia800408.us.archive.org/9/items/other-item/a.pdf")[0]
+    assert not cfg.is_url_allowed("archive", ok.replace("ia800408", "ia800409"))[0]
+    assert not cfg.is_url_allowed("archive", ok.replace("88375/88375.pdf", "88375/../other/a.pdf"))[0]
+    assert not check_config(cfg).errors
+
+
+def test_redirect_scope_must_be_one_item_directory_under_an_allowed_host():
+    def m(raw):
+        raw["sources"]["archive"]["redirect_scopes"] = [{"host": "ia800408.us.archive.org", "path_prefix": "/"},
+                                                       {"host": "evil.example", "path_prefix": "/1/items/a/"}]
+    errs = check_config(_cfg(m)).errors
+    assert any("path_prefix must be one item directory" in e for e in errs)
+    assert any("not a subdomain of an allowed host" in e for e in errs)
+
+
+def test_pinned_extra_ca_is_checked_and_partial_chain_is_cleared():
+    src = {"ca_extra_pem": "config/ca/egazette_intermediates.pem", "ca_extra_sha256": EGZ_PINS}
+    ctx = chttp.tls_verify_for(src)
+    assert isinstance(ctx, ssl.SSLContext)
+    assert ctx.verify_mode == ssl.CERT_REQUIRED and ctx.check_hostname
+    assert not (ctx.verify_flags & ssl.VERIFY_X509_PARTIAL_CHAIN)
+    with pytest.raises(ValueError):
+        chttp.load_pinned_pem({"ca_extra_pem": src["ca_extra_pem"], "ca_extra_sha256": EGZ_PINS[:1]})
+    assert chttp.tls_verify_for({}) is True
+
+
+def test_from_header_only_with_env(monkeypatch, tmp_path):
+    from crawler.audit import AuditLog
+    from crawler.state import StateDB
+    db = StateDB(tmp_path / "s.sqlite").__enter__()
+    cfg = load_config()
+    monkeypatch.delenv("MIMAMSA_CONTACT_EMAIL", raising=False)
+    c = chttp.PoliteClient(cfg, AuditLog(tmp_path / "la", db, "t"), "indiacode", replay=True,
+                           transport=chttp.httpx.MockTransport(lambda r: chttp.httpx.Response(404)))
+    assert "from" not in {k.lower() for k in c.client.headers}
+    monkeypatch.setenv("MIMAMSA_CONTACT_EMAIL", "owner@example.org")
+    c2 = chttp.PoliteClient(cfg, AuditLog(tmp_path / "lb", db, "t"), "indiacode", replay=True,
+                            transport=chttp.httpx.MockTransport(lambda r: chttp.httpx.Response(404)))
+    assert c2.client.headers.get("from") == "owner@example.org"
