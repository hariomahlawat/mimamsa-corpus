+        # The contact address goes into the HTTP From header only when the owner sets MIMAMSA_CONTACT_EMAIL
+        # (C12 section 10 item 7 / C13 brief); the config value is no longer sent by default.
+        frm = os.environ.get("MIMAMSA_CONTACT_EMAIL", "").strip()
         self.client = httpx.Client(transport=transport, follow_redirects=False,
                                    timeout=float(cfg.setting(source, "timeout_seconds")),
