                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Where a sentence of transportation or imprisonment is directed to be undergone in a civil prison the offender may be kept in a military prison or in military custody or in any other fit place, till such time as it is possible send him to a civil prison. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
