                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Where the conduct of any person subject to this Act when being taken prisoner by, or while in the hands of, the enemy, is to be inquired into under this Act or any other law, <sup>1</sup>[the Chief of the Army Staff] or any officer authorised by him may order that the whole or any part of the pay and allowances of such person shall be withheld pending the result of such inquiry. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
