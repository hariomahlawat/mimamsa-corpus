                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>When any person subject to this Act is tried and sentenced by a court-martial while on board a ship, the finding and sentence so far as not confirmed and executed on board the ship, may be confirmed and executed in like manner as if such person had been tried at the port of disembarkation. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
