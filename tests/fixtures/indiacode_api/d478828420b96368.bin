                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "119",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>A district court-martial shall have power to try any person subject to this Act other than an officer or a junior commissioned officer for any offence made punishable therein, and to pass any sentence authorised by this Act other than a sentence of death, transportation, or imprisonment for a term exceeding two years:<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> Provided that a district court-martial shall not sentence a warrant officer to imprisonment.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
