                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_number" : [ {
                  "value" : "36",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "31660",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "136",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Nothing in section 135 shall be deemed to affect the operation of sections 123 and 124 of the Indian Evidence Act, 1872 (1 of 1872) or to apply to any letter, postcard, telegram or other document in the custody of the postal or telegraph authorities.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) If any document in such custody is, in the opinion of any district magistrate, chief presidency magistrate, High Court or Court of Session, wanted for the purpose of any court-martial, such magistrate or Court may require the postal or telegraph authorities, as the case may be, to deliver such document to such person as such magistrate or Court may direct.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (3) If any such document is, in the opinion of any other magistrate or of any commissioner of police or district superintendent of police, wanted for any such purpose, he may require the postal or telegraph authorities, as the case may be, to cause search to be made for and to detain such document pending the orders of any such district magistrate, chief presidency magistrate or High Court or Court of Session.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
