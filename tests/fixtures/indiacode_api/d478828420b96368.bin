                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The Central Government, <sup>1</sup>[the Chief of the Army Staff] or any prescribed officer may annul the proceedings of any court-martial on the ground that they are illegal or unjust. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
