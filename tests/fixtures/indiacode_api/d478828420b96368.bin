                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>A person under sentence of transportation or imprisonment may during his conveyance from place to place, or when on board ship, aircraft, or otherwise, be subjected to such restraint as is necessary for his safe conduct and removal. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
