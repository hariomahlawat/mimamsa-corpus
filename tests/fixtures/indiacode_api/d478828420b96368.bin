                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>A general or summary general court-martial shall have power to try any person subject to this Act for any offence punishable therein and to pass any sentence authorised thereby.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
