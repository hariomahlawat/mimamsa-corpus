                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_number" : [ {
                  "value" : "40",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "31670",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "146",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Where any accused person, having been found by reason of unsoundness of mind to be incapable of making his defence, is in custody or under detention under section 145, the officer commanding the army, army corps, division or brigade within the area of whose command the accused is in custody or is detained, or any other officer prescribed in this behalf, may--<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span> (a) if such person is in custody under sub-section <i>(4)</i> of section 145, on the report of a medical officer that he is capable of making his defence, or<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span> (b) if such person is detained in a jail under sub-section <i>(5)</i> of section 145, on a certificate of the Inspector General of Prisons, and if such person is detained in a lunatic asylum under the said subsection on a certificate of any two or more of the visitors of such asylum that he is capable of making his defence,<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> take steps to have such person tried by the same or another court-martial for the offence with which he was originally charged or, if the offence is a civil offence, by a criminal court. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
