                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>It shall be lawful for proper provision to be made by the prescribed authorities for any dependants of any person subject to this Act who is a prisoner of war or is missing, out of his pay and allowances.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
