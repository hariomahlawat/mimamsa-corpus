                "dc.identifier.next_section" : [ {
                  "value" : "113.Composition of general court-martial.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
