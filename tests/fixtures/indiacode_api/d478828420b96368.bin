                "dc.identifier.next_section" : [ {
                  "value" : "189.Scope of power of suspension.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "189",
                  "language" : null,
