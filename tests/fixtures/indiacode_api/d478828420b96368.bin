                  "place" : 0
                } ],
                "dc.identifier.next_section" : [ {
                  "value" : "124.Place of trial.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "123",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_from" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_number" : [ {
                  "value" : "34",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup>. Subs. by s. 10, <i>ibid</i>., for certain words.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "31647",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "123",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Where an offence under this Act had been committed by any person while subject to this Act, and he has ceased to be so subject, he may be taken into and kept in military custody, and tried and punished for such offence as if he continued to be so subject.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) No such person shall be tried for an offence, unless his trial commences <sup>1</sup>[within a period of three years after he had ceased to be subject to this Act; and in computing such period, the time during which such person has avoided arrest by absconding or concealing himself or where the institution of the proceeding in respect of the offence has been stayed by an injunction or order, the period of the continuance of the injunction or order, the day on which it was issued or made, and the day on which it was withdrawn, shall be excluded:]<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> Provided that nothing contained in this sub-section shall apply to the trial of any such person for an offence of desertion or fraudulent enrolment or for any of the offences mentioned in section 37 or shall affect the jurisdiction of a criminal court to try any offence triable by such court as well as by a courtmartial.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (3) When a person subject to this Act is sentenced by a court-martial to transportation or imprisonment, this Act shall apply to him during the term of his sentence, though he is cashiered or dismissed from the regular Army, or has otherwise ceased to be subject to this Act, and he may be kept, removed, imprisoned and punished as if he continued to be subject to this Act.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (4) When a person subject to this Act is sentenced by a court-martial to death, this Act shall apply to him till the sentence is carried out.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
