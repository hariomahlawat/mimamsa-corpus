                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>The Central Government may set apart any building or part of a building, or any place under its control, as a military prison for the confinement of persons sentenced to imprisonment under this Act. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
