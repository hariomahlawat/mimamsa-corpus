                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Rules made under section 177 shall not authorise corporal punishment to be inflicted for any offence, nor render the imprisonment more severe than it is under the law for the time being in force relating to civil prisons. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
