                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "121",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>When any person subject to this Act has been acquitted or convicted of an offence by a court-martial or by a criminal court, or has been dealt with under any of the sections 80, 83, 84 and 85, he shall not be liable to be tried again for the same offence by a court- martial or dealt with under the said sections. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
