                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>A general court- martial may be convened by the Central Government or <sup>1</sup>[the Chief of the Army Staff] or by any officer empowered in this behalf by warrant of <sup>1</sup>[the Chief of the Army Staff ]. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
