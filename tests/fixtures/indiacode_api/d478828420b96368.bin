                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Whenever an order is duly made under this Act setting aside or varying any sentence, order or warrant under which any person is confined in a civil or military prison, a warrant in accordance with such order shall be forwarded by the officer making the order or his staff officer or such other person as may be prescribed to the officer in charge of the prison in which such person is confined. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
