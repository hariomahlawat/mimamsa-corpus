                  "place" : 0
                } ],
                "dc.identifier.next_section" : [ {
                  "value" : "146.Subsequent fitness of lunatic accused for trial.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "145",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_from" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_number" : [ {
                  "value" : "39",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.page_to" : [ {
                  "value" : "0",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.repealed" : [ {
                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "31669",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "145",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Whenever, in the course of a trial by a court-martial, it appears to the court that the person charged is by reason of unsoundness of mind incapable of making his defence, or that he committed the act alleged but was by reason of unsoundness of mind incapable of knowing the nature of the act or knowing that it was wrong or contrary to law, the court shall record a finding accordingly.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) The presiding officer of the court, or, in the case of a summary court-martial, the officer holding the trial, shall forthwith report the case to the confirming officer, or to the authority empowered to deal with its finding under section 162, as the case may be.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (3) The confirming officer to whom the case is reported under sub-section <i>(2)</i> may, if he does not confirm the finding, take steps to have the accused person tried by the same or another court-martial for the offence with which he was charged.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (4) The authority to whom the finding of a summary court-martial is reported under sub-section <i>(2)</i>, and a confirming officer confirming a finding in any case so reported to him shall order the accused person to be kept in custody in the prescribed manner and shall report the case for the orders of the Central Government.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (5) On receipt of a report under sub-section <i>(4)</i> the Central Government may order the accused person to be detained in a lunatic asylum or other suitable place of safe custody. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
