                  "value" : "31708",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "183",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) Where the sentence referred to in section 182 is imposed by a court-martial other than a summary court-martial, the confirming officer may, when confirming the sentence, direct that the offender be not committed to prison or to military custody until the orders of the authority or officer specified in section 182 have been obtained.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) Where a sentence of imprisonment is imposed by a summary court-martial, the officer holding the trial or the officer authorised to approve of the sentence under sub-section <i>(2)</i> of section 161 may make the direction referred to in sub-section <i>(1)</i>. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
