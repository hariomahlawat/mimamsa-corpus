                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>A court-martial may take judicial notice of any matter within the general military knowledge of the members.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
