                "dc.identifier.section_number" : [ {
                  "value" : "150",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>When any property regarding which any offence appears to have been committed, or which appears to have been used for the commission of any offence, is produced before a court-martial during a trial, the court may make such order as it thinks fit for the proper custody of such property pending the conclusion of the trial, and if the property is subject to speedy or natural decay may, after recording such evidence as it thinks necessary, order it to be sold or otherwise disposed of. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
