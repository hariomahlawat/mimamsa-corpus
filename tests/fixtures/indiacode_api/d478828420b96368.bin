                "dc.identifier.section_number" : [ {
                  "value" : "149",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Where any relative or friend of any person who is in custody under sub-section <i>(4)</i> of section 145 or under detention under sub-section <i>(5)</i> of that section desires that he should be delivered to his care and custody, the Central Government may upon application by such relative or friend and on his giving security to the satisfaction of that Government that the person delivered shall be properly taken care of and prevented from doing injury to himself or any other person, and be produced for the inspection of such officer, and at such times and places, as the Central Government may direct, order such person to be delivered to such relative or friend. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
