                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>If, after complying with the provisions of section 13, the enrolling officer is satisfied that the person desirous of being enrolled fully understands the questions put to him and consents to the conditions of service, and if such officer perceives no impediment, he shall sign and shall also cause such person to sign the enrolment paper, and such person shall thereupon be deemed to be enrolled.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
