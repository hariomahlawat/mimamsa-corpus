                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Any person subject to this Act may be retired, released or discharged from the service by such authority and in such manner as may be prescribed. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
