                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Notwithstanding anything contained in clause <i>(i)</i> of section 3, the Central Government may, by notification, declare that any person or class of persons subject to this Act shall, with reference to any area in which they may be serving or with reference to any provision of this Act or of any other law for the time being in force, be deemed to be on active service within the meaning of this Act. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
