                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) This Act may be called the Army Act, 1950.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) It shall come into force on such date<sup>1</sup> as the Central Government may, by notification in the Official Gazette, appoint in this behalf.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
