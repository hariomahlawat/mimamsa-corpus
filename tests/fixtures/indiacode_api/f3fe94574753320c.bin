                "dc.identifier.next_section" : [ {
                  "value" : "30.Immunity of persons attending courts-martial from arrest.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "29",
                  "language" : null,
