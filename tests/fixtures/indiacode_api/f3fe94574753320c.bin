                "dc.identifier.next_section" : [ {
                  "value" : "8.Officers exercising powers in certain cases.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "7",
