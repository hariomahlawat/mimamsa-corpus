                "dc.identifier.next_section" : [ {
                  "value" : "41.Disobedience to superior officer.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "40",
