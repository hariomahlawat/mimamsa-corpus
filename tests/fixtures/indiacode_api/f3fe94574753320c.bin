                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>A sentence of a court-martial may award in addition to, or without any one other punishment, the punishment specified in clause <i>(d)</i> or clause <i>(e)</i> of section 71 and any one or more of the punishments specified in clauses <i>(f)</i> to <i>(l)</i> of that section.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
