                "dc.identifier.next_section" : [ {
                  "value" : "63.Violation of good order and discipline.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "62",
