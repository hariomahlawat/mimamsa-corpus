                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Any officer who deems himself wronged by his commanding officer or any superior officer and who on due application made to his commanding officer does not receive the redress to which he considers himself entitled, may complain to the Central Government in such manner as may from time to time be specified by the proper authority.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
