                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>In every case in which punishment has been awarded under any of the sections 83, 84 and 85, certified true copies of the proceedings shall be forwarded, in the prescribed manner, by the officer awarding the punishment, to a superior military authority as defined in section 88.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
