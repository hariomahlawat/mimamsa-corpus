                  "value" : "false",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "31539",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "15",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Every person who has for the space of three months been in receipt of pay as a person enrolled under this Act and been borne on the rolls of any corps or department shall be deemed to have been duly enrolled, and shall not be entitled to claim his discharge on the ground of any irregularity or illegality in his enrolment or on any other ground whatsoever ; and if any person, in receipt of such pay and borne on the rolls as aforesaid, claims his discharge before the expiry of three months from his enrolment, no such irregularity or illegality or other ground shall, until he is discharged in pursuance of his claim, affect his position as an enrolled person under this Act or invalidate any proceeding, act or thing taken or done prior to his discharge.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.state_id" : [ {
                  "value" : "1",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
