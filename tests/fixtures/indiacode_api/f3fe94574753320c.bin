                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Any person subject to this Act who abets the commission of any of the offences punishable with death under sections 34, 37 and sub-section <i>(1)</i> of section 38 shall, on conviction by court- martial, if that offence be not committed in consequence of the abetment, and no express provision is made by this Act for the punishment of such abetment, be liable to suffer imprisonment for a term which may extend to fourteen years or such less punishment as is in this Act mentioned.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
