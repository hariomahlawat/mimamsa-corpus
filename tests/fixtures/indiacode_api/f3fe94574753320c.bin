                "dc.identifier.next_section" : [ {
                  "value" : "7.Commanding officer of persons subject to military law under clause (i) of section 2.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
