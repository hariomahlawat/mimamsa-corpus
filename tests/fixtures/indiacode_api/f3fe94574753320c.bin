                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>If any punishment awarded under any of the sections 83, 84 and 85 appears to a superior military authority as defined in section 88 to be illegal, unjust or excessive, such authority may cancel, vary or remit the punishment and make such other direction as may be appropriate in the circumstances of the case.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
