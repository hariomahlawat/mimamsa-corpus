                "dc.identifier.section_footnote" : [ {
                  "value" : "<sup>1</sup>. Subs. by Act 19 of 1955, s. 2 and the Schedule, for \"the Commander-in-Chief\".<br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/> <sup>2</sup>. Subs. by Act 37 of 1992, s. 6, for certain words. <br/><hr style=\"border: none; margin-bottom: 3px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
