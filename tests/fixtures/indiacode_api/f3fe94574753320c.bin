                } ],
                "dc.identifier.section_id" : [ {
                  "value" : "31585",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "61",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Any officer, junior commissioned officer, warrant officer or noncommissioned officer who, having received the pay of a person subject to this Act unlawfully detains or refuses to pay the same when due, shall, on conviction by court- martial, be liable to suffer imprisonment for a term which may extend to ten years or such less punishment as is in this Act mentioned.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
