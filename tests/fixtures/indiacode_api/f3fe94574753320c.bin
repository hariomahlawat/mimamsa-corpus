                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Any person subject to this Act who commits any of the following offences, that is to say,--<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span> (a) commits extortion; or<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span><span style=\"margin-left: 15px;\"></span> (b) without proper authority exacts from any person money, provisions or service;<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> shall, on conviction by court-martial, be liable to suffer imprisonment for a term which may extend to ten years or such less punishment as is in this Act mentioned.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
