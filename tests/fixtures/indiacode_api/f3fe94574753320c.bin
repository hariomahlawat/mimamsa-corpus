                "dc.identifier.next_section" : [ {
                  "value" : "9.Power to declare persons to be on active service.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.order_number" : [ {
                  "value" : "8",
