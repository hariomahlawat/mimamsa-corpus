                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>Punishments may also be inflicted in respect of offences committed by persons subject to this Act without the intervention of a court-martial and in the manner stated in sections 80, 83, 84 and 85.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
