                } ],
                "dc.identifier.section_number" : [ {
                  "value" : "30",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.identifier.section_page_note" : [ {
                  "value" : "<span style=\"margin-left: 15px;\"></span>(1) No presiding officer or member of a court-martial, no judge advocate, no party to any proceeding before a court-martial, or his legal practitioner or agent, and no witness acting in obedience to a summons to attend a court-martial shall, while proceeding to, attending or returning from, a court-martial, be liable to arrest under civil or revenue process.<br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/> <span style=\"margin-left: 15px;\"></span> (2) If any such person is arrested under any such process, he may be discharged by order of the courtmartial. <br/><hr style=\"border: none; margin-bottom: 8px; margin-top: 0;\"/>",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
