    "dc.legislation.history" : [ {
      "value" : "<p>Legislative History: </p><p>The Army Act, 1950</p><p></p><p></p><p></p><p>Act Title\tThe Army Act, 1950</p><p>Act Number\tAct No. 46 of 1950</p><p>Act ID (India Code)\t1950-46</p><p> Presidential Assent date\tMay 20, 1950</p><p> Enforcement Date\tJuly 22, 1950 </p><p>Nodal Ministry\tMinistry of Defence </p><p> </p><p>Precedent &amp; Historical Rationale</p><p></p><p>1.\tReplacement of Colonial Legislation:</p><p>Enacted to repeal and replace the Indian Army Act, 1911, which was obsolete under independent India&#39;s constitutional setup.</p><p>2.\tUniform Code of Military Discipline: </p><p>Established updated statutory guidelines governing commission, enrollment, service terms, offenses, military courts (courts-martial), and executive powers over land forces.</p><p>Parliamentary Trajectory &amp; Enactment</p><p></p><p></p><p>•\tFormulation: Introduced alongside the Air Force Bill in Parliament to streamline military discipline under post-1950 legal standards.</p><p>•\tParliamentary passage: Passed by the Provisional Parliament in May 1950.</p><p>•\tPresidential Assent: Received Assent from the President of India on May 20, 1950.</p><p>•\tEnforcement: Enforced on July 22, 1950.</p><p>•\tSource: Official Record of Parliament, India Code, and Ministry of Defence (Department of Military Affairs)</p><p></p>",
      "language" : null,
      "authority" : null,
      "confidence" : -1,
      "place" : 0
    } ],
